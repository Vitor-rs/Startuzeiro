# Arquivo de configuração de ambiente para o Startuzeiro
# Copie este arquivo para .env e preencha com as suas chaves reais

# Chave de API do Firecrawl (https://firecrawl.dev)
FIRECRAWL_API_KEY=sua_chave_firecrawl_aqui

# Chave de API do TranscriptAPI (https://transcriptapi.com)
TRANSCRIPT_API_KEY=sua_chave_transcriptapi_aqui

# Chave de API do Context7 (https://context7.com)
CONTEXT7_API_KEY=sua_chave_context7_aqui

# Chave de API do Exa (https://exa.ai)
EXA_API_KEY=sua_chave_exa_aqui

# Chave de API do cnpj.ai (https://cnpj.ai)
CNPJ_AI_API_KEY=sua_chave_cnpj_ai_aqui

# Chave de API do Hunter.io (https://hunter.io)
HUNTER_API_KEY=sua_chave_hunter_aqui

# Chave de API do Apollo.io (https://apollo.io)
APOLLO_API_KEY=sua_chave_apollo_aqui
