{
    "openapi": "3.1.0",
    "info": {
        "title": "YouTube Transcript API - Public",
        "description": "TranscriptAPI: extract the transcript of any YouTube video as structured JSON, with or without timestamps. The same API also covers search, channels, playlists, and video metadata.\n\nBase URL: [https://transcriptapi.com](https://transcriptapi.com) (every path below is under /api/v2/youtube).\n\nAuth: send Authorization: Bearer YOUR_API_KEY. Get a key at [https://transcriptapi.com/dashboard/api-keys](https://transcriptapi.com/dashboard/api-keys).\n\nCredits: failed calls and 429s cost 0; successful calls cost 1 credit unless the endpoint states otherwise. Costs are stated on each endpoint, including per-page pricing on paginated endpoints. Cached responses (HTTP 200) also cost 1 credit.\n\nRate limits: 200 requests per minute per key. Honor X-RateLimit headers and Retry-After on 429.\n\nErrors: every endpoint documents its status codes and retry flags; retry only 408, 429, and 503.\n\nCommon tasks:\n- Transcribe a video: GET /api/v2/youtube/transcript?video_url=UF8uR6Z6KLc\n- Find videos on a topic to transcribe: GET /api/v2/youtube/search?q=ocean+conservation&type=video&upload_date=week\n- Size up a channel (subscribers, video count, tabs): GET /api/v2/youtube/channel/info?channel=@NASA\n- Pull a channel's videos, Shorts, or streams: GET /api/v2/youtube/channel/videos?channel=@NASA&tab=shorts\n- Get a video's likes, views, description links, and related videos: GET /api/v2/youtube/video/metadata?video_url=UF8uR6Z6KLc&include=related\n- List a playlist's videos: GET /api/v2/youtube/playlist/videos?playlist=<URL or PL... ID>\n- Check a video's available transcript languages, at no credit cost: GET /api/v2/youtube/info?video_url=UF8uR6Z6KLc\n- Do all of this from Claude Desktop or any MCP client: [https://transcriptapi.com/docs/mcp](https://transcriptapi.com/docs/mcp)\n\nGuides and full reference: [https://transcriptapi.com/docs/api](https://transcriptapi.com/docs/api)",
        "version": "1.0.0"
    },
    "paths": {
        "/api/v2/youtube/transcript": {
            "get": {
                "tags": [
                    "YouTube transcript"
                ],
                "summary": "Get YouTube transcript (v2)",
                "description": "Get a YouTube video's transcript — pass a video URL or 11-character ID as `video_url`.\n\nBy default you get English, or the video's first available language if there's no English.\n\nTo choose a language, set `language` to a comma-separated list in priority order; we return the first one that's available. Example: `language=de,en,asr` tries German, then English, then the auto-generated captions.\n\n- `asr` = the video's auto-generated captions (ASR = automatic speech recognition).\n- `asr-<code>` = auto-generated captions in a specific language, e.g. `asr-hi`.\n- A plain code like `hi` returns the human-made captions if they exist, otherwise the auto-generated ones (`asr-hi`).\n- Language codes ignore region (`de` matches `de-DE`) and are case-insensitive. Up to 10 codes.\n\nThe `language` field in the response always tells you exactly what you got. Tip: call GET /api/v2/youtube/info first (it's free) to see which languages a video offers.",
                "operationId": "get_transcript_v2_api_v2_youtube_transcript_get",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "video_url",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^([a-zA-Z0-9_-]{11}|https?://.*)$",
                            "description": "YouTube video URL or bare 11-char ID",
                            "title": "Video Url"
                        },
                        "description": "YouTube video URL or bare 11-char ID"
                    },
                    {
                        "name": "language",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Optional comma-separated language priority list (e.g. `de,en,asr`). Omit it to get English, or the video's first available language. We return the first code that's available. `asr` = auto-generated captions; `asr-<code>` = a specific auto language (e.g. `asr-hi`). Codes ignore region (`de` matches `de-DE`). The response's `language` field tells you exactly what you got — ask for `hi` and you'll see `asr-hi` if only auto captions exist.",
                            "title": "Language"
                        },
                        "description": "Optional comma-separated language priority list (e.g. `de,en,asr`). Omit it to get English, or the video's first available language. We return the first code that's available. `asr` = auto-generated captions; `asr-<code>` = a specific auto language (e.g. `asr-hi`). Codes ignore region (`de` matches `de-DE`). The response's `language` field tells you exactly what you got — ask for `hi` and you'll see `asr-hi` if only auto captions exist.",
                        "examples": {
                            "german_then_english": {
                                "summary": "Prefer German, fall back to English",
                                "description": "Returns German captions if available, otherwise English.",
                                "value": "de,en"
                            },
                            "auto_generated": {
                                "summary": "Auto-generated captions only",
                                "description": "Skips human-made captions and asks for the ASR track directly.",
                                "value": "asr"
                            }
                        }
                    },
                    {
                        "name": "send_metadata",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "description": "Include basic video metadata in response",
                            "default": false,
                            "title": "Send Metadata"
                        },
                        "description": "Include basic video metadata in response"
                    },
                    {
                        "name": "format",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "$ref": "#/components/schemas/TranscriptFormatV2",
                            "description": "Response format: json or text",
                            "default": "json"
                        },
                        "description": "Response format: json or text"
                    },
                    {
                        "name": "include_timestamp",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "description": "Include timestamps in transcript output",
                            "default": true,
                            "title": "Include Timestamp"
                        },
                        "description": "Include timestamps in transcript output"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Transcript retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/APITranscriptResponseV2"
                                }
                            }
                        }
                    }
                }
            }
        },
